APP_NAME=CipherLearn
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Structured JSON logs to stderr so the container runtime (ECS/CCE) collects them.
# Every line carries a `request_id` (see App\Http\Middleware\AssignRequestId).
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8. Host `mysql` is the docker-compose service name. MySQL (not Postgres)
# keeps the Aurora migration path open — see README.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=cipherlearn
DB_USERNAME=cipherlearn
DB_PASSWORD=secret

# Redis backs sessions, cache and the queue. Host `redis` is the compose service.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Object storage is reached ONLY through the S3 API so the app stays portable
# across MinIO (local), AWS S3 and Huawei OBS. No cloud-specific SDK calls.
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=cipherlearn
AWS_SECRET_ACCESS_KEY=miniosecret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=cipherlearn
AWS_USE_PATH_STYLE_ENDPOINT=true
# Point at the MinIO service locally; unset in cloud to use the provider default.
AWS_ENDPOINT=http://minio:9000
AWS_URL=http://localhost:9000/cipherlearn

# Dev/demo mail goes to the Mailpit container (web inbox at http://localhost:8025),
# so notifications are visible without a real provider. Set MAIL_MAILER=log to
# silence, or point at a real transport for production (see .env.production.example).
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS="hello@cipherlearn.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
