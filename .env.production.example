# ─────────────────────────────────────────────────────────────────────────────
# CipherLearn — PRODUCTION environment template.
#
# Copy to `.env` on the host (or supply these as container secrets / env vars) and
# fill every CHANGEME. NEVER commit a real .env. See docs/DEPLOY.md for the full
# runbook. Values that differ from local are called out; the rest mirror
# .env.example.
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME=CipherLearn
# Production mode + debug OFF — the debug error page leaks SQL, env and cookies.
APP_ENV=production
APP_DEBUG=false
# A real 32-byte key, provided as a SECRET (do not let the entrypoint generate one
# in prod). Generate once with: php artisan key:generate --show
APP_KEY=CHANGEME
# The public HTTPS URL the app is served at.
APP_URL=https://learn.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Structured JSON logs to stderr for the container runtime to collect.
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter
LOG_DEPRECATIONS_CHANNEL=null
# Quieter in production.
LOG_LEVEL=warning

# ── Database (managed MySQL 8 / Aurora in cloud) ──────────────────────────────
DB_CONNECTION=mysql
DB_HOST=CHANGEME
DB_PORT=3306
DB_DATABASE=cipherlearn
DB_USERNAME=CHANGEME
DB_PASSWORD=CHANGEME

# ── Redis (sessions, cache, queue) ────────────────────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=120
# Encrypt session payloads at rest in production.
SESSION_ENCRYPT=true
SESSION_PATH=/
# Lock cookies to the app host.
SESSION_DOMAIN=learn.example.com

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=CHANGEME
REDIS_PASSWORD=CHANGEME
REDIS_PORT=6379

# ── Object storage (S3-compatible: AWS S3 / Huawei OBS) ───────────────────────
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=CHANGEME
AWS_SECRET_ACCESS_KEY=CHANGEME
AWS_DEFAULT_REGION=CHANGEME
AWS_BUCKET=CHANGEME
# Cloud S3 uses virtual-hosted style; leave false unless your provider needs true.
AWS_USE_PATH_STYLE_ENDPOINT=false
# Leave AWS_ENDPOINT unset in cloud to use the provider default (set it only for
# an S3-compatible endpoint like OBS/MinIO). AWS_URL is the public asset base.
# AWS_ENDPOINT=
AWS_URL=https://cdn.example.com/cipherlearn

# ── Mail ──────────────────────────────────────────────────────────────────────
# Env-driven: point at a real transport (SES / Mailgun / SMTP). Example SMTP:
MAIL_MAILER=smtp
MAIL_HOST=CHANGEME
MAIL_PORT=587
MAIL_USERNAME=CHANGEME
MAIL_PASSWORD=CHANGEME
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="learning@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
